# Copy this file to .env and add your own credentials.
# Never commit .env or paste secret values into issues or chat.

GROQ_API_KEY=replace_with_your_groq_key
FISH_API_KEY=replace_with_your_fish_audio_key
OPENROUTER_API_KEY=replace_with_your_openrouter_key

# Optional: your Fish Audio voice reference. Leave blank to use the default.
FISH_REFERENCE_ID=
